{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report_insights.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["insights_version", "week_id", "date_range", "executive_summary", "actions"],
  "properties": {
    "insights_version": { "type": "string", "const": "insights.v1" },
    "week_id": { "type": "string", "minLength": 3 },
    "date_range": { "type": "string", "minLength": 3 },
    "executive_summary": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "what_worked": { "type": "array", "items": { "type": "string" }, "minItems": 0 },
    "what_didnt": { "type": "array", "items": { "type": "string" }, "minItems": 0 },
    "diagnostics": { "type": "object", "additionalProperties": true },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "owner": { "type": "string" },
          "task": { "type": "string" },
          "deliverable": { "type": "string" },
          "why": { "type": "string" },
          "kpi": { "type": "string" },
          "stoploss": { "type": "string" }
        }
      }
    },
    "data_issues": { "type": "array", "items": { "type": "string" }, "minItems": 0 },
    "open_questions": { "type": "array", "items": { "type": "string" }, "minItems": 0 }
  }
}
