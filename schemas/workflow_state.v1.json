{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow_state.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "week_id",
    "date_range",
    "kpi_snapshot",
    "decisions",
    "guardrail_check",
    "consultant_summary",
    "department_actions",
    "risks",
    "validation_plan"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "workflow_state.v1" },
    "week_id": { "type": "string", "minLength": 3 },
    "date_range": { "type": "string", "minLength": 3 },
    "kpi_snapshot": { "type": "object", "additionalProperties": true },
    "decisions": { "type": "array", "items": { "type": ["string", "object"] }, "minItems": 1 },
    "guardrail_check": { "type": "object", "additionalProperties": true },
    "consultant_summary": {
      "anyOf": [
        { "type": "array", "items": { "type": ["string", "object"] } },
        { "type": "object", "additionalProperties": true },
        { "type": "string" }
      ]
    },
    "department_actions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      }
    },
    "risks": { "type": "array", "items": { "type": ["object", "string"], "additionalProperties": true }, "minItems": 1 },
    "validation_plan": { "type": "object", "additionalProperties": true }
  }
}
