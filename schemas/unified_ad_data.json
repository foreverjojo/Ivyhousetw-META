{
  "$comment": "檔案用途：定義跨平台通用的廣告數據統一格式（Unified Ad Data），供 adapters 轉換、驗證與後續 KPI/報表流程共用。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivyhouse.tw/schemas/unified_ad_data.json",
  "title": "unified_ad_data",
  "type": "object",
  "additionalProperties": true,
  "required": ["data"],
  "properties": {
    "version": {
      "type": "string",
      "default": "unified_ad_data.v1"
    },
    "generated_at": {
      "type": "string",
      "description": "產出時間（ISO 8601），可選。",
      "examples": ["2026-01-04T16:30:00+08:00"]
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Taipei"
    },
    "source": {
      "type": "string",
      "description": "資料來源描述（例如 meta_csv）。"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unified_ad_record" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "money": {
      "type": "number",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "conversion_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "value"],
      "properties": {
        "count": { "$ref": "#/$defs/count" },
        "value": { "$ref": "#/$defs/money" }
      }
    },
    "unified_ad_record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "level", "id", "name", "time_range", "currency", "metrics"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["meta", "shopee", "momo"]
        },
        "level": {
          "type": "string",
          "enum": ["campaign", "adset", "ad"]
        },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "time_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/date" },
            "end": { "$ref": "#/$defs/date" }
          }
        },
        "currency": {
          "type": "string",
          "default": "TWD",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "required": ["spend", "impressions", "clicks", "conversions", "funnel"],
          "properties": {
            "spend": { "$ref": "#/$defs/money" },
            "impressions": { "$ref": "#/$defs/count" },
            "clicks": { "$ref": "#/$defs/count" },
            "conversions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["truth", "platform"],
              "properties": {
                "truth": { "$ref": "#/$defs/conversion_pair" },
                "platform": { "$ref": "#/$defs/conversion_pair" }
              }
            },
            "funnel": {
              "type": "object",
              "additionalProperties": false,
              "required": ["atc", "ic", "lpv"],
              "properties": {
                "atc": { "$ref": "#/$defs/count" },
                "ic": { "$ref": "#/$defs/count" },
                "lpv": { "$ref": "#/$defs/count" }
              }
            }
          }
        }
      }
    }
  }
}
