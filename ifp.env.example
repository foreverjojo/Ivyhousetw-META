# Ivy House Meta 環境變數設定（範本檔）
# 請複製此檔案並命名為 ifp.env，然後填入您的設定
# ⚠️ API Key 請勿存放在此檔案，應使用 Secret Manager 或系統環境變數


# 1. OpenRouter API Key
# 📌 安全做法：設定 SECRET_MANAGER_ENABLED=true，並將 API Key 存入 GCP Secret Manager
# 📌 本機開發：可在 Windows 系統環境變數中設定 OPENROUTER_API_KEY
# OPENROUTER_API_KEY=（請勿在此設定，改用 Secret Manager）

# 2. 2026 模型配置 (透過 OpenRouter)
# --- 主要 Model (頂級配置) ---
MODEL_CONSULTANT_A=openai/gpt-5.2-pro
MODEL_CONSULTANT_B=google/gemini-3-pro-preview
MODEL_CONSULTANT_C=anthropic/claude-opus-4.5
MODEL_MODERATOR=openai/gpt-5.2-pro
MODEL_INSIGHTS=openai/gpt-4o-mini

# --- 備用 Model (當主要 Model 不可用時自動切換) ---
MODEL_CONSULTANT_A_FALLBACK=openai/gpt-5.2-chat
MODEL_CONSULTANT_B_FALLBACK=google/gemini-3-flash-preview
MODEL_CONSULTANT_C_FALLBACK=anthropic/claude-sonnet-4.5
MODEL_MODERATOR_FALLBACK=anthropic/claude-opus-4.5

# 3. 雲端整合 (Phase 2.3)
CLOUD_MEDIA_PROVIDER=gdrive
GOOGLE_DRIVE_FOLDER_ID=1_e_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service Account JSON 檔案路徑 (務必放入 .gitignore 保護的路徑，例如 secrets/)
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-service-account-key.json
# 備援用 Access Token (若無 SA JSON 才使用)
GOOGLE_DRIVE_ACCESS_TOKEN=

# 4. HTTP 參數
CLOUD_HTTP_TIMEOUT_S=120

# 5. 其他設定
HISTORY_ROOT=history
SCHEMAS_DIR=schemas
TAIPEI_TZ=Asia/Taipei
SECRET_MANAGER_ENABLED=false
GCP_PROJECT_ID=ivyhouse-ad-analyzer
