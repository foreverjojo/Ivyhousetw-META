{
  "name": "Ivyhousetw-META (py3.11 + node24.12.0)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {},
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/workspaces/Ivyhousetw-META/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "alefragnani.project-manager",
        "anseki.vscode-color",
        "anthropic.claude-code",
        "bierner.color-info",
        "bierner.markdown-checkbox",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "chouzz.vscode-better-align",
        "christian-kohler.path-intellisense",
        "continue.continue",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "everettjf.filter-line",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "google.geminicodeassist",
        "gruntfuggly.todo-tree",
        "gxl.git-graph-3",
        "jlcodes.antigravity-cockpit",
        "johnpapa.vscode-peacock",
        "justin-grote.powershell-extension-pack",
        "louiswt.regexp-preview",
        "ms-azuretools.vscode-containers",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode-remote.remote-wsl",
        "ms-vscode-remote.vscode-remote-extensionpack",
        "ms-vscode.remote-explorer",
        "ms-vscode.remote-server",
        "oderwat.indent-rainbow",
        "openai.chatgpt",
        "pod212.vscode-github-projects",
        "rangav.vscode-thunder-client",
        "redhat.vscode-yaml",
        "richie5um2.vscode-sort-json",
        "ritwickdey.liveserver",
        "slevesque.vscode-zipexplorer",
        "streetsidesoftware.code-spell-checker",
        "tylerleonhardt.vscode-inline-values-powershell",
        "usernamehw.errorlens",
        "vscode-icons-team.vscode-icons",
        "vsls-contrib.codetour",
        "vsls-contrib.gistfs",
        "vsls-contrib.gitdoc",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/Ivyhousetw-META",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspaces/Ivyhousetw-META,type=bind,consistency=cached"
  ],
  "postCreateCommand": "bash -lc 'set -euo pipefail; cd /workspaces/Ivyhousetw-META; if [ ! -d .venv ]; then python -m venv .venv; fi; . .venv/bin/activate; python -m pip install -U pip; if command -v uv >/dev/null 2>&1; then :; else python -m pip install -U uv; fi; if [ -f uv.lock ]; then uv sync --frozen; else uv pip install -r requirements.txt; fi'"
}
